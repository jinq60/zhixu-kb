# =====================================================================
# 知序智能知识库 - 环境变量模板
# 复制为 .env.local（非敏感）与 .env.secrets.local（敏感）使用
# =====================================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zhixu_kb
DB_USERNAME=root
DB_PASSWORD=root

# ---------- Redis（可选，未启动时自动降级） ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 服务地址 ----------
OCR_SERVICE_URL=http://localhost:5001
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ---------- Neo4j 知识图谱 ----------
# 注意：密码须与本机 Neo4j 实际密码一致（README 的 docker run 示例与 docker-compose 均使用 zhixu123456）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zhixu123456
NEO4J_ENABLED=true

# ---------- AI 引擎（云端 API） ----------
AI_ENGINE_TYPE=api
AI_MODEL=deepseek-chat

# ---------- SMTP 邮件（登录验证码） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- GitHub OAuth ----------
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# ---------- 文件存储 ----------
FILE_UPLOAD_PATH=./uploads/images/
