# =====================================================================
# 知序智能知识库 - 敏感环境变量模板
# 复制为 .env.secrets.local 并填写真实值；请勿提交真实密钥到仓库
# =====================================================================

# ---------- 平台默认云端模型（所有用户免配置可用） ----------
# 推荐便宜/免费方案（任选其一，都是 OpenAI 兼容接口）：
#   1) 智谱 GLM-4-Flash（免费）:  https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
#   2) DeepSeek-chat（超低价）:   https://api.deepseek.com             模型 deepseek-chat
#   3) 通义千问 qwen-turbo（低价）: https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-turbo
# 填入后所有访客直接使用该默认模型；用户也可在"AI 设置"配自己的 Key 覆盖。
AI_API_KEY=
AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 兼容旧变量名（AI 整理等沿用）
DEEPSEEK_API_KEY=

# ---------- 安全密钥（必须填写，缺失或过短时后端拒绝启动） ----------
# 用系统随机数生成 32 字节以上随机串，例如：
#   powershell -c "$b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
JWT_SECRET=
CRYPTO_AES_KEY=

# ---------- 管理员引导密钥（注册时携带该 key 的用户自动成为管理员） ----------
# 注意：bootstrap-first-admin-only=true 时，首个管理员创建后该 key 自动失效
ADMIN_BOOTSTRAP_KEY=

# ---------- 会话 Cookie（HttpOnly，JS 不可读；SameSite=Lax 防跨站携带） ----------
# 本地 http 开发保持 false；公网 HTTPS 部署必须设为 true（否则浏览器拒收 Secure Cookie）
AUTH_COOKIE_SECURE=false
