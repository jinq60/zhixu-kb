<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志消息统一脱敏（邮箱/手机号/身份证/长 token） -->
    <conversionRule conversionWord="maskedMsg" converterClass="com.zhixu.kb.security.MaskingMessageConverter"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %maskedMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
