# LNO-OCR environment configuration

# Service
OCR_HOST=0.0.0.0
OCR_PORT=5001
OCR_DEBUG=false
OCR_CORS=true

# ------------------------------------------------------------
# OCR engine switch (IMPORTANT)
# true  -> use DeepSeek-OCR-2 (requires NVIDIA CUDA + CUDA PyTorch)
# false -> use PaddleOCR (CPU-friendly, recommended default)
# ------------------------------------------------------------
USE_DEEPSEEK_OCR=false

# Multi-channel engine routing (new)
# OCR_ENABLE_PADDLE=true
# OCR_ENABLE_DEEPSEEK=false
# OCR_DEFAULT_ENGINE=auto     # auto | paddle | deepseek
# OCR_FALLBACK_ENGINES=paddle,deepseek

# DeepSeek settings (used only when USE_DEEPSEEK_OCR=true)
# Use local path if model was downloaded offline.
DEEPSEEK_OCR_MODEL=./models/DeepSeek-OCR-2
MODEL_CACHE_DIR=./models
USE_GPU=true
USE_BF16=true
MAX_NEW_TOKENS=2048

# PaddleOCR settings (used only when USE_DEEPSEEK_OCR=false)
OCR_LANG=ch
OCR_USE_ANGLE=false
OCR_USE_GPU=false

# Optional local model dirs for PaddleOCR 3.x offline init
# PADDLE_DET_MODEL_DIR=./models/paddle/PP-OCRv5_server_det
# PADDLE_REC_MODEL_DIR=./models/paddle/PP-OCRv5_server_rec
# PADDLE_CLS_MODEL_DIR=./models/paddle/PP-LCNet_x1_0_textline_ori
